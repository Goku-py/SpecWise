generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Status replaces the old boolean isActive flag (phase2):
//   isActive=true  → status='active'
//   isActive=false → status='archived'
enum Status {
  draft
  active
  archived
}

model Laptop {
  id                String   @id @default(cuid())
  brand             String
  model             String
  variant           String?
  os                String
  cpuBrand          String
  cpuFamily         String
  cpuGeneration     String?
  cpuCores          Int?
  cpuBenchmark      Int?
  gpuType           String   @default("integrated")
  gpuModel          String?
  gpuVRAM           Int?
  ramAmount         Int
  ramType           String?
  ramUpgradeable    Boolean  @default(false)
  storageAmount     Int
  storageType       String   @default("SSD")
  storageExpandable Boolean  @default(false)
  displaySize       Float
  displayResolution String?
  displayRefreshRate Int     @default(60)
  displayPanelType  String?
  displayBrightness Int?
  displayColorGamut String?
  displayTouch      Boolean  @default(false)
  batteryCapacity   Int?
  batteryLife       Int?
  weight            Float?
  buildMaterial     String?
  webcamQuality     String?
  ports             String[]
  wireless          String?
  securityFeatures  String[]
  keyboardBacklit   Boolean  @default(false)
  isTouchscreen     Boolean  @default(false)
  isRefurbished     Boolean  @default(false)
  // slug is the new URL identity (SEO-friendly, stable). The DB column is
  // intentionally NON-unique and nullable to keep migration risk low — uniqueness
  // is enforced in application code (seed + future write layer) via slugify +
  // collision suffixes. Backfill happens in the seed, not in SQL.
  slug              String?
  // Optional FK to Brand. Kept nullable + no required relation constraint so the
  // existing `brand String` display field can stay untouched (40+ consumers).
  brandId           String?
  status            Status   @default(active)
  isPopular         Boolean  @default(false)
  imageUrl          String?
  reviewScore       Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  prices         LaptopPrice[]
  priceSnapshots PriceSnapshot[]

  brandRef Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([slug])
}

model LaptopPrice {
  laptopId         String
  region           String
  retailer         String   @default("default")
  currency         String
  // price is in WHOLE currency units (major units), NOT cents — e.g. 1099 means
  // $1,099.00 (see data/laptops.json: price: 1099 for a ~$1099 laptop). This is
  // deliberately different from PriceSnapshot.priceCents (minor units). Do not
  // change semantics without a migration + formatPrice() audit.
  price            Int
  url              String?
  affiliateUrl     String?
  priceLastUpdated DateTime @default(now())

  laptop Laptop @relation(fields: [laptopId], references: [id], onDelete: Cascade)

  // ponytail: retailer in the key so multiple sellers per laptop/region can coexist
  @@id([laptopId, region, retailer])
  @@index([region])
  @@index([laptopId, region, price])
}

// ponytail: no TTL cleanup — 86K+ rows/day at 60 req/min/IP. Add a cron job
// (DELETE FROM "RateLimit" WHERE "updatedAt" < now() - interval '24 hours')
// or use the in-memory fallback exclusively in serverless.
model RateLimit {
  id        String   @id @default(uuid())
  key       String
  window    DateTime
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, window])
}

// ponytail: optional email leads captured at quiz end; answers kept for later send/resend
model Lead {
  id        String   @id @default(cuid())
  email     String
  region    String   @default("US")
  answers   Json
  createdAt DateTime @default(now())

  @@unique([email, region])
}

// phase2: brand master data. Laptop.brandId is optional — legacy rows keep the
// denormalized `brand` string on Laptop until they are linked via the seed.
model Brand {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  logoUrl String?

  laptops Laptop[]
}

// phase2: retailer master data. `code` is the stable slug-style identifier used
// by LaptopPrice.retailer / PriceSnapshot.retailer; `name` is the display label.
model Retailer {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  baseUrl          String
  linkTemplate     String?
  affiliateProgram String?
  enabled          Boolean  @default(true)
}

// phase2: time-series price snapshots for future price-history charts.
// priceCents is in MINOR units (cents) — unlike LaptopPrice.price (major units).
model PriceSnapshot {
  id         String   @id @default(cuid())
  laptopId   String
  retailer   String
  region     String
  priceCents Int
  currency   String
  inStock    Boolean  @default(true)
  capturedAt DateTime @default(now())

  laptop Laptop @relation(fields: [laptopId], references: [id], onDelete: Cascade)

  @@index([laptopId, capturedAt])
  @@unique([laptopId, retailer, region, capturedAt])
}
